<?xml version="1.0"?>
<package format="3">
  <name>piper_hardware</name>
  <version>0.0.1</version>
  <description>
    Real-hardware bridge for Piper arm: translates ros2_control position+velocity
    command interfaces into piper_sdk JointMitCtrl calls (MIT mode).
  </description>

  <maintainer email="tian@todo.todo">tian</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime: ROS2 core -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <!-- Runtime: robot description -->
  <exec_depend>piper_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Runtime: ros2_control stack -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>admittance_controller</exec_depend>
  <exec_depend>force_torque_sensor_broadcaster</exec_depend>
  <exec_depend>kinematics_interface</exec_depend>
  <exec_depend>kinematics_interface_kdl</exec_depend>

  <!-- Simulation (re-uses piper_mujoco for the ros2_control config) -->
  <exec_depend>piper_mujoco</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
