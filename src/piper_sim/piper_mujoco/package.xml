<?xml version="1.0"?>
<package format="3">
  <name>piper_mujoco</name>
  <version>0.0.1</version>
  <description>MuJoCo viewer nodes for the Piper arm (simulation-specific)</description>

  <maintainer email="tian@todo.todo">tian</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime: ROS2 core (used by viewer scripts) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <!-- Runtime: robot description -->
  <exec_depend>piper_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Runtime: MuJoCo hardware interface for ros2_control -->
  <exec_depend>mujoco_ros2_control</exec_depend>

  <!-- Generic compliance control stack -->
  <exec_depend>compliance_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
